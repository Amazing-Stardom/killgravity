[Unit]
Description=killgravity - Antigravity Runaway Dump Guard & Process Watchdog (System Service)
Documentation=https://github.com/Amazing-Stardom/killgravity
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/killgravity daemon
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

